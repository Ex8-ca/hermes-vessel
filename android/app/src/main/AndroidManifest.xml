<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Optional floating call button; the user grants it in system settings, and it shows only during a call. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Lets the screenshot consent prompt hide every overlay (ours included) while it is open. -->
  <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:theme="@style/Theme.HermesVessel">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="hermesvessel" android:host="pair" />
      </intent-filter>
    </activity>

    <!-- Own empty task + translucent: approving a screenshot from another app returns to THAT app, so it is
         the screen that gets captured (not Vessel's main window brought forward by the prompt). -->
    <activity
      android:name=".ScreenConsentActivity"
      android:exported="false"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:noHistory="false"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <service android:name=".ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />

    <service
      android:name=".TalkService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>
